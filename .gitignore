# Python bytecode caches
__pycache__/
*.py[cod]

# Packaging / editable installs
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editor and OS files
.vscode/
.idea/
.DS_Store
.claude
Thumbs.db
docs/

# Excel/Office lock files created while a workbook is open
~$*

# Training checkpoints: only each run's ppo_latest.pt is committed (via Git LFS)
checkpoints/**
!checkpoints/**/
!checkpoints/**/ppo_latest.pt
